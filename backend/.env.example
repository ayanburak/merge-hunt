# Copy this file to .env in the same folder and fill in the values.
# .env is ignored by git, so the real token never ends up in the repo.

# A GitHub token is required. A fine-grained token with read-only access to
# public repositories is enough, it needs no extra permissions.
GITHUB_TOKEN=

# Optional. By default the database is backend/data/merge_hunt.db.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/merge_hunt.db
