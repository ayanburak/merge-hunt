{
  "name": "merge-hunt-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "api:types": "uv run --project ../backend python -c \"import json; from merge_hunt.main import app; print(json.dumps(app.openapi()))\" > openapi.tmp.json && npx -y -p openapi-typescript@7.13.0 -p typescript@5.9 openapi-typescript openapi.tmp.json -o src/api/schema.d.ts; rm -f openapi.tmp.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0-alpha-1790635538000",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
